# Copy this file to .env.mlflow (already git-ignored) and fill in real, generated values.
# Never commit .env.mlflow or paste secret values into any tracked file.
#
# Used only by docker-compose.mlflow.yml and scripts/mlflow_backup.sh / mlflow_restore.sh --
# always pass explicitly, e.g.:
#   docker compose --env-file .env.mlflow -f docker-compose.mlflow.yml up -d --build
# Compose only auto-loads a literal `.env`, never a differently-named file.

# Postgres backend store (MLflow's tracking/registry metadata).
MLFLOW_POSTGRES_USER=mlflow
MLFLOW_POSTGRES_PASSWORD=
MLFLOW_POSTGRES_DB=mlflow

# MinIO (S3-compatible artifact store). Locally this is MinIO; the same variable shape maps
# to OTC OBS on the future VM migration (ADR Anhang A.2, docs/hackathon-otc-upload.md
# convention) -- only the endpoint/credential values change, never the variable names.
MLFLOW_MINIO_ROOT_USER=
MLFLOW_MINIO_ROOT_PASSWORD=
MLFLOW_ARTIFACT_BUCKET=ffep-mlflow-artifacts
