<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block title %}{{ title | default('') }}{% endblock %}</title>
<style>
  body {
    font-size: 18px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    background: #ffffff;
    color: #1a1a1a;
    margin: 0;
    padding: 1.5rem;
  }

  h1, h2 {
    border-bottom: 3px solid #1f4e79;
    padding-bottom: 0.3rem;
  }

  .subtitle {
    color: #666;
    margin-top: -0.5rem;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    margin: 1rem 0;
  }

  th, td {
    padding: 0.5rem 0.6rem;
    border-bottom: 1px solid #ddd;
    text-align: left;
    word-wrap: break-word;
    overflow-wrap: break-word;
  }

  th {
    background: #1f4e79;
    color: #ffffff;
  }

  .chart-img {
    width: 100%;
    height: auto;
    display: block;
  }

  .summary-block {
    font-size: 1.15em;
    border-left: 6px solid #1f4e79;
    padding: 0.75rem 1rem;
    margin: 1rem 0;
    background: #f7f9fb;
  }

  .muted-cell {
    color: #999;
  }

  .warning-block {
    border-left: 6px solid #d99b1c;
    padding: 0.75rem 1rem;
    margin: 1rem 0;
    background: #fdf6e8;
  }

  .section-basis {
    font-size: 0.85em;
    color: #666;
  }

  footer {
    margin-top: 2rem;
    font-size: 0.85em;
    color: #666;
    border-top: 1px solid #ddd;
    padding-top: 0.75rem;
  }

  @media print {
    body {
      print-color-adjust: exact;
      -webkit-print-color-adjust: exact;
    }

    .summary-block, .chart-block, table {
      break-inside: avoid;
      page-break-inside: avoid;
    }

    a[href]::after {
      content: none;
    }
  }
</style>
</head>
<body>
<h1>{{ self.title() }}</h1>
<p class="subtitle">{% block subtitle %}{% endblock %}</p>
{% block content %}{% endblock %}
<footer>{% block footnotes %}{% endblock %}</footer>
</body>
</html>
