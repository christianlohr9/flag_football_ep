# Copy this file to .env (already git-ignored) and fill in real values.
# Never commit .env or paste secret values into any tracked file.

# sportapp.fi play-by-play API key, used by `ffep fetch-sportapp`.
# The key previously committed in plaintext at config/config.py is
# compromised (it lives in git history regardless of the code fix) and
# must be rotated with the sportapp.fi provider before reuse.
SPORTAPP_API_KEY=

# cpx.studio (IFAF WM-2026) API key, used by `ffep fetch-ifaf`.
# Optional: the endpoints observed so far carry no apikey parameter, so
# this is only needed if a live call returns 401/403.
CPX_API_KEY=

# Credentials for the self-hosted CVAT instance (docs/cv-setup.md's ## CVAT
# section), used by `ffep cv cvat-push` / `ffep cv cvat-pull`. This is the
# local Docker Compose instance on 127.0.0.1:8080 (D-06) -- never a hosted
# CVAT service. Set after running `docker exec -it cvat_server bash -ic
# 'python3 ~/manage.py createsuperuser'`.
CVAT_USERNAME=
CVAT_PASSWORD=
